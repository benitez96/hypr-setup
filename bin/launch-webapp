#!/bin/bash

browser=$(xdg-settings get default-web-browser)

# Check if it's a flatpak application
if [[ $browser == com.* ]]; then
  # Extract the flatpak app ID (e.g., com.brave.Browser from com.brave.Browser.desktop)
  app_id=$(echo "$browser" | sed 's/\.desktop$//')
  exec setsid uwsm-app -- flatpak run "$app_id" --app="$1" "${@:2}"
fi

case $browser in
google-chrome* | brave-browser* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

exec_line=$(sed -n 's/^Exec=//p' {~/.local,~/.nix-profile,/usr}/share/applications/$browser 2>/dev/null | head -1)
# Remove %U/%u/%F/%f placeholders but keep env VAR=VALUE pairs intact
exec_line=$(echo "$exec_line" | sed 's/[[:space:]]*%[A-Za-z]//g')
exec setsid uwsm-app -- $exec_line --app="$1" "${@:2}"
