#!/bin/bash

# Merge multiple PDFs into one
# Usage: pdfmerge input1.pdf input2.pdf ... output.pdf

if [ "$#" -lt 2 ]; then
  echo "Uso: $0 <input1> <input2> ... <output.pdf>"
  exit 1
fi

# img2pdf and gs never see anything but the input files. See pdf-sandbox.
source "$(dirname "$(readlink -f "$0")")/pdf-sandbox"

salida="${@: -1}"
entradas=("${@:1:$#-1}")

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

sandbox_output "$tmpdir"

final_inputs=()
n=0

for f in "${entradas[@]}"; do
  case "${f,,}" in
    *.pdf)
      sandbox_input "$f"
      final_inputs+=("$sandbox_path")
      ;;
    *.jpg|*.jpeg|*.png)
      sandbox_input "$f"
      sandbox_run img2pdf "$sandbox_path" -o "$sandbox_out/img_$n.pdf" || exit 1
      final_inputs+=("$sandbox_out/img_$n.pdf")
      n=$((n+1))
      ;;
    *)
      echo "Formato no soportado: $f"
      exit 1
      ;;
  esac
done

sandbox_run gs -dBATCH -dNOPAUSE -dQUIET -dSAFER \
   -sDEVICE=pdfwrite \
   -sPAPERSIZE=a4 \
   -dPDFFitPage \
   -sOutputFile="$sandbox_out/merged.pdf" \
   "${final_inputs[@]}" || exit 1

mv "$tmpdir/merged.pdf" "$salida"
