#!/bin/bash

export PATH="${HYPR_SETUP_PATH:-$HOME/.local/share/hypr}/bin:$PATH"

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ "$BACK_TO_EXIT" == "true" ]]; then
    exit 0
  elif [[ -n "$parent_menu" ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  # Index mode: dump the options of the first menu reached and bail out. All
  # fallthrough branches (*) are navigation, so nothing gets executed.
  if [[ -n "$MENU_DUMP_FILE" ]]; then
    [[ -s "$MENU_DUMP_FILE" ]] || echo -e "$options" >"$MENU_DUMP_FILE"
    return 0
  fi

  # Pick mode: answer the first prompt with the entry chosen in the flat list,
  # so the existing case dispatches the real action.
  if [[ -n "$MENU_ANSWER_FILE" && -f "$MENU_ANSWER_FILE" ]]; then
    cat "$MENU_ANSWER_FILE"
    rm -f "$MENU_ANSWER_FILE"
    return 0
  fi

  read -r -a args <<<"$extra"

  if [[ -n "$preselect" ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n "$index" ]]; then
      # Rofi uses 0-based indexing, and -selected-row flag
      args+=("-selected-row" "$((index - 1))")
    fi
  fi

  echo -e "$options" | rofi -dmenu -i -p "$prompt" -width 295 -lines 15 "${args[@]}" 2>/dev/null
}

terminal() {
  xdg-terminal-exec --app-id=org.hypr.terminal "$@"
}

present_terminal() {
  launch-floating-terminal-with-presentation $1
}

open_in_editor() {
  notify-send "Editing config file" "$1"
  launch-editor "$1"
}

install() {
  present_terminal "echo 'Installing $1...'; sudo pacman -S --noconfirm $2"
}

install_and_launch() {
  present_terminal "echo 'Installing $1...'; sudo pacman -S --noconfirm $2 && setsid gtk-launch $3"
}

install_font() {
  present_terminal "echo 'Installing $1...'; sudo pacman -S --noconfirm --needed $2 && sleep 2 && font-set '$3'"
}

install_terminal() {
  # Terminal installer removed - install manually
  present_terminal "echo 'Installing $1...'; sudo pacman -S --noconfirm --needed $1"
}

aur_install() {
  present_terminal "echo 'Installing $1 from AUR...'; yay -S --noconfirm $2"
}

aur_install_and_launch() {
  present_terminal "echo 'Installing $1 from AUR...'; yay -S --noconfirm $2 && setsid gtk-launch $3"
}

show_learn_menu() {
  case $(menu "Learn" "  Keybindings\n  Hyprland\n󰣇  Arch\n  Neovim\n󱆃  Bash") in
  *Keybindings*) menu-keybindings ;;
  # Removed: Omarchy manual link - no longer relevant
  *Hyprland*) launch-webapp "https://wiki.hypr.land/" ;;
  *Arch*) launch-webapp "https://wiki.archlinux.org/title/Main_page" ;;
  *Bash*) launch-webapp "https://devhints.io/bash" ;;
  *Neovim*) launch-webapp "https://www.lazyvim.org/keymaps" ;;
  *) show_main_menu ;;
  esac
}

show_capture_menu() {
  case $(menu "Capture" "󰨸  Clipboard\n😀  Emoji\n  Screenshot\n󰃉  Color") in
  *Clipboard*) launch-rofi -m clipboard ;;
  *Emoji*) launch-rofi -m emoji ;;
  *Screenshot*) show_screenshot_menu ;;
  *Color*) pkill hyprpicker || hyprpicker -a ;;
  *) show_main_menu ;;
  esac
}

show_screenshot_menu() {
  case $(menu "Screenshot" "  Snap with Editing\n  Straight to Clipboard") in
  *Editing*) cmd-screenshot smart ;;
  *Clipboard*) cmd-screenshot smart clipboard ;;
  *) show_capture_menu ;;
  esac
}

show_toggle_menu() {
  case $(menu "Toggle" "󱄄  Screensaver\n󰔎  Nightlight\n󱫖  Idle Lock\n󰍜  Top Bar") in
  *Screensaver*) toggle-screensaver ;;
  *Nightlight*) toggle-nightlight ;;
  *Idle*) toggle-idle ;;
  *Bar*) toggle-waybar ;;
  *) show_main_menu ;;
  esac
}

show_style_menu() {
  case $(menu "Style" "󰸌  Theme\n  Font\n  Background\n  Hyprland\n󱄄  Screensaver\n  About") in
  *Theme*) show_theme_menu ;;
  *Font*) show_font_menu ;;
  *Background*) theme-bg-next ;;
  *Hyprland*) open_in_editor ~/.config/hypr/looknfeel.lua ;;
  *Screensaver*) open_in_editor ~/.config/hypr/branding/screensaver.txt ;;
  *About*) open_in_editor ~/.config/hypr/branding/about.txt ;;
  *) show_main_menu ;;
  esac
}

show_theme_menu() {
  show-theme-menu
}

show_font_menu() {
  theme=$(menu "Font" "$(font-list)" "--width 350" "$(font-current)")
  if [[ "$theme" == "CNCLD" || -z "$theme" ]]; then
    back_to show_style_menu
  else
    font-set "$theme"
  fi
}

show_setup_menu() {
  local options="  Audio\n󰓃  Double Audio Output\n  Wifi\n󰂯  Bluetooth\n󱐋  Power Profile\n󰍹  Monitors\n🖨️  Printers"
  [ -f ~/.config/hypr/bindings.lua ] && options="$options\n  Keybindings"
  [ -f ~/.config/hypr/input.lua ] && options="$options\n  Input"
  options="$options\n  Defaults\n󰱔  DNS\n  Security\n  Config"

  case $(menu "Setup" "$options") in
  *Double*) launch-tui emit-double ;;
  *Audio*) launch-or-focus-tui wiremix ;;
  *Wifi*) launch-wifi ;;
  *Bluetooth*) launch-bluetooth ;;
  *Power*) show_setup_power_menu ;;
  *Monitors*) open_in_editor ~/.config/hypr/monitors.lua ;;
  *Printers*) uwsm-app -- system-config-printer ;;
  *Keybindings*) open_in_editor ~/.config/hypr/bindings.lua ;;
  *Input*) open_in_editor ~/.config/hypr/input.lua ;;
  *Defaults*) open_in_editor ~/.config/uwsm/default ;;
  *DNS*) present_terminal setup-dns ;;
  *Security*) show_setup_security_menu ;;
  *Config*) show_setup_config_menu ;;
  *) show_main_menu ;;
  esac
}

show_setup_power_menu() {
  profile=$(menu "Power Profile" "$(powerprofiles-list)" "" "$(powerprofilesctl get)")

  if [[ "$profile" == "CNCLD" || -z "$profile" ]]; then
    back_to show_setup_menu
  else
    powerprofilesctl set "$profile"
  fi
}

show_setup_config_menu() {
  case $(menu "Setup" "  Hyprland\n  Hypridle\n  Hyprlock\n  Hyprsunset\n  Swayosd\n󰌧  Walker\n󰍜  Waybar\n󰞅  XCompose") in
  *Hyprland*) open_in_editor ~/.config/hypr/hyprland.lua ;;
  *Hypridle*) open_in_editor ~/.config/hypr/hypridle.conf && restart-hypridle ;;
  *Hyprlock*) open_in_editor ~/.config/hypr/hyprlock.conf ;;
  *Hyprsunset*) open_in_editor ~/.config/hypr/hyprsunset.conf && restart-hyprsunset ;;
  *Swayosd*) open_in_editor ~/.config/swayosd/config.toml && restart-swayosd ;;
  *Waybar*) open_in_editor ~/.config/waybar/config.jsonc && restart-waybar ;;
  *XCompose*) open_in_editor ~/.XCompose && notify-send "XCompose" "Restart manually if needed" ;;
  *) show_main_menu ;;
  esac
}

show_setup_security_menu() {
  case $(menu "Setup" "󰈷  Fingerprint\n  Fido2") in
  *Fingerprint*) present_terminal setup-fingerprint ;;
  *Fido2*) present_terminal setup-fido2 ;;
  *) show_setup_menu ;;
  esac
}

show_install_menu() {
  case $(menu "Install" "󰣇  Package\n󰣇  AUR\n  Web App\n  TUI") in
  *Package*) terminal pkg-install ;;
  *AUR*) terminal pkg-aur-install ;;
  *Web*) present_terminal webapp-install ;;
  *TUI*) present_terminal tui-install ;;
  # Removed: Service, Style, Development, Editor, Terminal, AI, Windows, Gaming - install manually if needed
  *) show_main_menu ;;
  esac
}

# Removed menus: Service, Editor, Terminal, AI, Gaming, Style, Development
# Install these manually if needed

show_remove_menu() {
  case $(menu "Remove" "󰣇  Package\n  Web App\n  TUI\n󰸌  Theme\n󰈷  Fingerprint\n  Fido2") in
  *Package*) terminal pkg-remove ;;
  *Web*) present_terminal webapp-remove ;;
  *TUI*) present_terminal tui-remove ;;
  *Theme*) present_terminal theme-remove ;;
  *Fingerprint*) present_terminal "setup-fingerprint --remove" ;;
  *Fido2*) present_terminal "setup-fido2 --remove" ;;
  *) show_main_menu ;;
  esac
}

show_update_menu() {
  case $(menu "Update" "󰏖  System\n  Process\n󰇅  Hardware\n  Firmware\n  Password\n  Timezone\n  Time") in
  *System*) present_terminal update ;;
  *Process*) show_update_process_menu ;;
  *Hardware*) show_update_hardware_menu ;;
  *Firmware*) present_terminal update-firmware ;;
  *Timezone*) present_terminal tz-select ;;
  *Time*) present_terminal update-time ;;
  *Password*) show_update_password_menu ;;
  *) show_main_menu ;;
  esac
}

# Removed show_update_channel_menu - no longer using update channels
show_update_process_menu() {
  case $(menu "Restart" "  Hypridle\n  Hyprsunset\n  Swayosd\n󰍜  Waybar") in
  *Hypridle*) restart-hypridle ;;
  *Hyprsunset*) restart-hyprsunset ;;
  *Swayosd*) restart-swayosd ;;
  *Waybar*) restart-waybar ;;
  *) show_update_menu ;;
  esac
}

# Removed show_update_config_menu - no longer using omarchy config refresh

show_update_hardware_menu() {
  case $(menu "Restart" "  Audio\n󱚾  Wi-Fi\n󰂯  Bluetooth") in
  *Audio*) present_terminal restart-pipewire ;;
  *Wi-Fi*) present_terminal restart-wifi ;;
  *Bluetooth*) present_terminal restart-bluetooth ;;
  *) show_update_menu ;;
  esac
}

show_update_password_menu() {
  case $(menu "Update Password" "  User") in
  *User*) present_terminal passwd ;;
  *) show_update_menu ;;
  esac
}

show_system_menu() {
  case $(menu "System" "  Lock\n󱄄  Screensaver\n󰜉  Restart\n󰐥  Shutdown") in
  *Lock*) lock-screen ;;
  *Screensaver*) launch-screensaver force ;;
  *Restart*) cmd-reboot ;;
  *Shutdown*) cmd-shutdown ;;
  *) back_to show_main_menu ;;
  esac
}

# Menus that hold other entries, with the breadcrumb they are reached through.
# Everything else (the leaves) is discovered from them, so actions stay defined
# in one place only.
MENU_TREE=(
  "|show_root_menu"
  "Learn|show_learn_menu"
  "Capture|show_capture_menu"
  "Capture > Screenshot|show_screenshot_menu"
  "Toggle|show_toggle_menu"
  "Style|show_style_menu"
  "Setup|show_setup_menu"
  "Setup > Security|show_setup_security_menu"
  "Setup > Config|show_setup_config_menu"
  "Install|show_install_menu"
  "Remove|show_remove_menu"
  "Update|show_update_menu"
  "Update > Process|show_update_process_menu"
  "Update > Hardware|show_update_hardware_menu"
  "Update > Password|show_update_password_menu"
  "System|show_system_menu"
)

# Run a menu function with rofi stubbed out, to capture the options it offers
dump_menu() {
  local tmp
  tmp=$(mktemp)
  (MENU_DUMP_FILE="$tmp" "$1") >/dev/null 2>&1
  cat "$tmp"
  rm -f "$tmp"
}

# Flat "icon  Path > Entry<TAB>function<TAB>raw option" list of every entry
build_menu_index() {
  local entry path func option icon label full
  local -A seen=()

  for entry in "${MENU_TREE[@]}"; do
    path="${entry%%|*}"
    func="${entry#*|}"

    while IFS= read -r option; do
      [[ -z "$option" ]] && continue

      label="${option##*  }"
      icon="${option%%  *}"
      [[ "$icon" == "$option" ]] && icon=""

      full="$label"
      [[ -n "$path" ]] && full="$path > $label"
      [[ -n "${seen["$full"]}" ]] && continue
      seen["$full"]=1

      printf '%s\t%s\t%s\n' "${icon:+$icon  }$full" "$func" "$option"
    done < <(dump_menu "$func")
  done
}

# Run the entry picked in the flat list: feed it back to the menu it belongs to,
# so that menu's own case runs the real action
run_menu_entry() {
  local line="$1"
  local func option tmp

  func=$(cut -f2 <<<"$line")
  option=$(cut -f3 <<<"$line")
  [[ -z "$func" || -z "$option" ]] && return

  tmp=$(mktemp)
  printf '%s' "$option" >"$tmp"
  MENU_ANSWER_FILE="$tmp" "$func"
  rm -f "$tmp"
}

# Plain top level, without the nested entries. Not shown as such: it is where
# the top level entries are read from, and where a pick among them is sent back.
MAIN_MENU_OPTIONS="󰀻  Apps\n󰧑  Learn\n  Capture\n󰔎  Toggle\n  Style\n  Setup\n󰉉  Install\n󰭌  Remove\n  Update\n  About\n  System"

show_root_menu() {
  go_to_menu "$(menu "Go" "$MAIN_MENU_OPTIONS")"
}

# Top level: the whole tree, flattened. It opens on the top level entries, and
# typing filters across every submenu, so "audio" finds "Setup > Audio".
show_main_menu() {
  local index choice

  # While indexing, fall back to the plain list, or we would recurse forever
  if [[ -n "$MENU_DUMP_FILE" ]]; then
    show_root_menu
    return
  fi

  index=$(build_menu_index)
  choice=$(cut -f1 <<<"$index" | rofi -dmenu -i -p "Go" -width 460 -lines 15 2>/dev/null)
  [[ -z "$choice" || "$choice" == "CNCLD" ]] && exit 0

  run_menu_entry "$(awk -F'\t' -v choice="$choice" '$1 == choice { print; exit }' <<<"$index")"
}

go_to_menu() {
  case "${1,,}" in
  *apps*) launch-rofi ;;
  *learn*) show_learn_menu ;;
  *capture*) show_capture_menu ;;
  *toggle*) show_toggle_menu ;;
  *style*) show_style_menu ;;
  *theme*) show_theme_menu ;;
  *screenshot*) show_screenshot_menu ;;
  *setup*) show_setup_menu ;;
  *power*) show_setup_power_menu ;;
  *install*) show_install_menu ;;
  *remove*) show_remove_menu ;;
  *update*) show_update_menu ;;
  *about*) launch-about ;;
  *system*) show_system_menu ;;
  esac
}

if [[ -n "$1" ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
