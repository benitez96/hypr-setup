#!/bin/bash

default_browser=$(xdg-settings get default-web-browser)

# Check if it's a flatpak application
if [[ $default_browser == com.* ]]; then
  # Extract the flatpak app ID (e.g., com.brave.Browser from com.brave.Browser.desktop)
  app_id=$(echo "$default_browser" | sed 's/\.desktop$//')
  
  # Determine private flag based on app ID
  if [[ $app_id =~ (firefox|zen|librewolf|mullvad) ]]; then
    private_flag="--private-window"
  elif [[ $app_id =~ edge ]]; then
    private_flag="--inprivate"
  else
    private_flag="--incognito"
  fi
  
  exec setsid uwsm-app -- flatpak run "$app_id" "${@/--private/$private_flag}"
fi

exec_line=$(sed -n 's/^Exec=//p' {~/.local,~/.nix-profile,/usr}/share/applications/$default_browser 2>/dev/null | head -1)
# Remove %U/%u/%F/%f placeholders but keep env VAR=VALUE pairs intact
exec_line=$(echo "$exec_line" | sed 's/[[:space:]]*%[A-Za-z]//g')
# Extract just the binary name (skip 'env' and VAR=VALUE pairs) for flag detection
browser_bin=$(echo "$exec_line" | sed 's/^env\b//; s/[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*//g; s/^[[:space:]]*//' | awk '{print $1}')

if [[ $browser_bin =~ (firefox|zen|librewolf|mullvad) ]]; then
  private_flag="--private-window"
elif [[ $browser_bin =~ edge ]]; then
  private_flag="--inprivate"
else
  private_flag="--incognito"
fi

exec setsid uwsm-app -- $exec_line "${@/--private/$private_flag}"
